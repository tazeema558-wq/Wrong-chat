const EMAIL_OTP_MAX_ATTEMPTS = 5;
const EMAIL_OTP_COOLDOWN_MS = 30 * 1000;
const EMAIL_OTP_DAILY_CAP = Math.max(1, Number(process.env.EMAIL_OTP_DAILY_CAP || 200));


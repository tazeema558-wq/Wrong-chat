app.post("/api/otp/send", async (req, res) => {
  const phone = normalizePhone(req.body?.phone);
  if (!phone) {
    return res.status(400).json({ ok: false, error: "Enter a valid 10-digit mobile number." });
  }

  const now = Date.now();
  const rec = otpStore.get(phone) || { sentCount: 0, hourStart: now, attempts: 0 };

  if (rec.sentAt && now - rec.sentAt < OTP_RESEND_COOLDOWN_MS) {
    const wait = Math.ceil((OTP_RESEND_COOLDOWN_MS - (now - rec.sentAt)) / 1000);
    return res.status(429).json({
      ok: false,
      error: `Please send the OTP again after ${wait} seconds.`,
      retryAfterSeconds: wait,
    });
  }

  if (now - rec.hourStart > 60 * 60 * 1000) {
    rec.hourStart = now;
    rec.sentCount = 0;
  }
  if (rec.sentCount >= OTP_MAX_PER_HOUR) {
    return res.status(429).json({
      ok: false,
      error: "Too many OTPs have been sent to this number. Try again after 1 hour.",
    });
  }

  // 🗓️ रोज़ की सीमा — वॉलेट सुरक्षित रहे
  if (otpRemainingToday() <= 0) {
    return res.status(429).json({
      ok: false,
      usePin: true,
      error:
        "Today's SMS limit is finished. Please log in with your PIN — OTP becomes available again after midnight.",
      dailyCap: OTP_DAILY_CAP,
    });
  }
  otpDayCount = otpToday() + 1;

  const code = String(Math.floor(100000 + Math.random() * 900000));
  const result = await sendSmsOtp(phone, code);

  if (!result.ok) {
    const code = String((result && result.detail && result.detail.status_code) || "");
    const hint = otpHintFor(code, result && result.detail && result.detail.message);
    console.log(`⚠️ OTP SMS fail [${result.provider}/${code}]: ${(result && result.detail && result.detail.message) || ""}`);
    return res.status(502).json({
      ok: false,
      error: hint || "There was a problem sending the SMS. Try again shortly or contact support.",
      provider: result.provider,
      mode: result.mode || OTP_MODE_LABEL,
      code: code || undefined,
    });
  }

  otpStore.set(phone, {
    hash: otpHash(phone, code),
    expiresAt: now + OTP_TTL_MS,
    attempts: 0,
    sentAt: now,
    sentCount: (rec.sentCount || 0) + 1,
    hourStart: rec.hourStart || now,
  });

  res.json({
    ok: true,
    provider: result.provider,
    mode: result.mode || OTP_MODE_LABEL,
    smsSent: result.provider !== "preview",
    expiresInSeconds: Math.round(OTP_TTL_MS / 1000),
    // 🔓 सिर्फ़ अगर Owner ने OTP_PREVIEW=1 सेट किया हो (टेस्टिंग के लिए)
    devOtp: OTP_PREVIEW ? code : undefined,
    message:
      result.provider === "preview"
        ? "OTP generated (test mode) — check the server log."
        : `OTP sent to your number +91${phone}.`,
  });
});

app.post("/api/otp/verify", async (req, res) => {
  const phone = normalizePhone(req.body?.phone);
  const code = String(req.body?.code || "").replace(/\D/g, "");

  if (!phone) return res.status(400).json({ ok: false, error: "The mobile number is not valid." });
  if (code.length !== 6) return res.status(400).json({ ok: false, error: "Enter the 6-digit OTP." });

  const rec = otpStore.get(phone);
  if (!rec) {
    return res.status(400).json({ ok: false, error: "Send the OTP first (tap Send OTP)." });
  }
  if (Date.now() > rec.expiresAt) {
    otpStore.delete(phone);
    return res.status(400).json({ ok: false, error: "The OTP has expired — send a new one.", expired: true });
  }
  if (rec.attempts >= OTP_MAX_ATTEMPTS) {
    otpStore.delete(phone);
    return res.status(429).json({ ok: false, error: "Too many wrong OTPs — request a new OTP." });
  }

  const expected = Buffer.from(rec.hash);
  const given = Buffer.from(otpHash(phone, code));
  let match = expected.length === given.length && crypto.timingSafeEqual(expected, given);

  // 🔁 Smart OTP (WhatsApp/SMS template) — कोड Fast2SMS ने बनाया हो तो वहीं से जाँचें
  if (!match && OTP_MODE_LABEL === "smart-otp") {
    const remote = await fast2smsVerifyRemote(phone, code);
    if (remote.ok) {
      match = true;
      otpStore.delete(phone);
      return res.json({ ok: true, token: otpToken(phone), phone, verifiedAt: Date.now(), verifiedBy: "fast2sms" });
    }
  }

  if (!match) {
    rec.attempts += 1;
    otpStore.set(phone, rec);
    return res.status(400).json({
      ok: false,
      error: `Wrong OTP! Attempts left: ${Math.max(0, OTP_MAX_ATTEMPTS - rec.attempts)}`,
      attemptsLeft: Math.max(0, OTP_MAX_ATTEMPTS - rec.attempts),
    });
  }

  otpStore.delete(phone);
  res.json({ ok: true, token: otpToken(phone), phone, verifiedAt: Date.now() });
});


// ============================================================================
// 📧 EMAIL OTP (v3.9.2) — ईमेल पर कोड, कोई DLT / WhatsApp टेम्पलेट नहीं
//    Render → Environment:
//      EMAIL_PROVIDER = brevo | resend      (खाली छोड़ें तो key से अपने आप तय)
//      BREVO_API_KEY  = xkeysib-xxxx        (Brevo → SMTP & API → API Keys)
//      RESEND_API_KEY = re_xxxx             (Resend → API Keys)
//      EMAIL_FROM     = aapka verified sender email
//      EMAIL_FROM_NAME= Wrong Chat
//      EMAIL_OTP_PREVIEW = 1                (सिर्फ़ टेस्ट: कोड ऐप में ही दिखेगा)
// ============================================================================

// 🔎 ENV AUTO-DISCOVERY (v3.9.2)
// Render में variable का नाम छोटा-बड़ा गलत हो, या Key/Value उलटे भर गए हों — फिर भी key मिल जाए।
function envTrim(name) {
  const v = process.env[name];
  return typeof v === "string" ? v.trim() : "";
}

const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[a-z]{2,}$/i;

// key पर लगे बेतुके अक्षर हटाओ — quotes, खाली जगह, नई लाइन, "api-key:" वगैरह
function cleanSecret(raw) {
  let v = String(raw == null ? "" : raw);
  v = v.replace(/\r|\n|\t/g, "");
  v = v.replace(/^\s*api-key\s*:\s*/i, "");
  v = v.replace(/^\s*(?:value|key)\s*=\s*/i, "");
  v = v.replace(/^["'`\s]+|["'`\s]+$/g, "");
  v = v.replace(/^<+|>+$/g, "");
  return v.trim();
}

function looksLikeSmtpKey(v) {
  return /^xsmtpsib-/i.test(v);
}

const SMTP_KEY_FOUND = Object.entries(process.env || {})
  .map(([, raw]) => cleanSecret(raw))
  .find((v) => looksLikeSmtpKey(v)) || "";

function detectBrevoKey() {
  const direct = cleanSecret(envTrim("BREVO_API_KEY"));
  if (direct && !looksLikeSmtpKey(direct)) return { key: direct, from: "BREVO_API_KEY" };
  for (const alias of ["BREVO_KEY", "BREVO_API", "BREVO_APIKEY", "BREVO_API_KEY_1", "BREVO_KEY_API", "BREVO_API", "BREVO_TOKEN"]) {
    const v = cleanSecret(envTrim(alias));
    if (v && !looksLikeSmtpKey(v)) return { key: v, from: alias };
  }
  // कहीं भी value जो xkeysib- से शुरू हो
  for (const [k, raw] of Object.entries(process.env)) {
    const v = cleanSecret(raw);
    if (/^xkeysib-/i.test(v)) return { key: v, from: "auto:" + k };
  }
  // कहीं भी value के बीचों-बीच xkeysib- (गलती से आगे-पीछे कुछ चिपक गया हो)
  for (const [k, raw] of Object.entries(process.env)) {
    const m = cleanSecret(raw).match(/xkeysib-[A-Za-z0-9_-]{20,}/i);
    if (m) return { key: m[0], from: "auto(from-value):" + k };
  }
  // Key/Value उलटे भर गए हों (नाम में key, value में "BREVO_API_KEY")
  for (const [k] of Object.entries(process.env)) {
    const name = k.trim();
    if (/^xkeysib-/i.test(name)) return { key: name, from: "auto(key-in-name)" };
  }
  // नाम में brevo और value लंबी
  for (const [k, raw] of Object.entries(process.env)) {
    const v = cleanSecret(raw);
    if (/brevo/i.test(k) && /key|api|token|secret/i.test(k) && v.length > 24 && !looksLikeSmtpKey(v)) {
      return { key: v, from: "auto:" + k };
    }
  }
  return { key: "", from: "none" };
}

function detectResendKey() {
  const direct = cleanSecret(envTrim("RESEND_API_KEY") || envTrim("RESEND_KEY"));
  if (direct) return { key: direct, from: "RESEND_API_KEY" };
  for (const [k, raw] of Object.entries(process.env)) {
    const v = cleanSecret(raw);
    if (/^re_[A-Za-z0-9_]{8,}$/.test(v)) return { key: v, from: "auto:" + k };
  }
  return { key: "", from: "none" };
}

function detectSender() {
  for (const n of ["EMAIL_FROM", "EMAIL_SENDER", "BREVO_SENDER_EMAIL", "SENDER_EMAIL", "MAIL_FROM", "FROM_EMAIL"]) {
    const v = envTrim(n);
    if (EMAIL_RE.test(v)) return { email: v, from: n };
  }
  for (const [k, raw] of Object.entries(process.env)) {
    const v = String(raw || "").trim();
    if (EMAIL_RE.test(v) && /(mail|sender|from|brevo)/i.test(k)) return { email: v, from: "auto:" + k };
  }
  return { email: "", from: "none" };
}

// 🔐 Render "Secret Files" से key पढ़ना — /etc/secrets/BREVO_API_KEY
function readSecretFile() {
  const tries = [
    "/etc/secrets/BREVO_API_KEY",
    "/etc/secrets/brevo_api_key",
    "/etc/secrets/brevo_api_key.txt",
    "/etc/secrets/BREVO_API_KEY.txt",
  ];
  for (const p of tries) {
    try {
      if (fs.existsSync(p)) {
        const v = cleanSecret(fs.readFileSync(p, "utf8"));
        if (v) return { key: v, from: "secretfile:" + p };
      }
    } catch {
      // ignore
    }
  }
  return { key: "", from: "none" };
}

